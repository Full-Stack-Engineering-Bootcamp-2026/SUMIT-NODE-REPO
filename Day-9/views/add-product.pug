doctype html
html
  head
    title= pageTitle
  body
    h1 Add Product

    form(action="/add-product", method="POST")
      div
        label Title
        input(type="text", name="title", required)

      div
        label Price
        input(type="number", name="price", required)

      button(type="submit") Add Product

    br
    a(href="/") Back